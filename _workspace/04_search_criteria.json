{
  "version": "2.0",
  "track": "auction",
  "note": "진단 결과(유형 3축 + 사실 입력 4개) → 법원경매 검색조건. 같은 입력이면 항상 같은 결과(결정적).",
  "source_of_truth": {
    "typology": "_workspace/01_typology.md",
    "types_and_questions": "_workspace/02_diagnostic.json",
    "regulations": "_workspace/00_regulations.md (기준일 2026-07-01, 규제 수치는 이 문서만 인용)"
  },
  "disclaimer": "본 매핑은 성향에 맞는 물건을 찾는 출발점일 뿐 투자·세무·법률 자문이 아니다. 실제 입찰·대출·세금 적용 전 금융기관·세무사·법무사와 해당 시점 규정을 직접 확인하라.",

  "rules": {
    "price_max": {
      "formula": "equity_top × ltv_mult × reserve_coef",
      "equity_top": { "u50": 50000000, "u150": 150000000, "u300": 300000000, "o300": 400000000 },
      "ltv_mult": {
        "normal": { "none": 3.3, "one": 3.3, "multi": 2.31 },
        "regulated": { "none": 1.7, "one": 1.0, "multi": 1.0 },
        "unknown": { "none": 1.7, "one": 1.0, "multi": 1.0 }
      },
      "ltv_basis": {
        "normal_70": "비규제 LTV 70% → 1/(1-0.7) ≈ 3.3배 (00_reg C)",
        "normal_multi": "비규제라도 다주택 추가구입은 한도·DSR 제약 → 3.3 × 0.7 = 2.31 (00_reg B-1)",
        "regulated_none_40": "규제지역 무주택 LTV 40% → 1/(1-0.4) ≈ 1.7배. 생애최초면 70%(3.3배)로 상향 가능 (00_reg A-2)",
        "regulated_one_multi_0": "규제지역 미처분 1주택·다주택 추가구입 주담대 금지 → 자기자본만 1.0배 (00_reg A-1)",
        "unknown": "판정 불가 시 규제지역 기준으로 보수적 계산"
      },
      "reserve_coef": {
        "base": 1.0,
        "WORK_H": 0.85,
        "RIGHTS_R": 0.9,
        "note": "해당하는 계수를 모두 곱한다. 수리·명도·소송 예비비를 미리 떼어놓기 위한 성향 계수이며 규제 수치가 아니다."
      },
      "rounding": "만 원 단위 내림"
    },

    "price_min": {
      "u50": 30000000,
      "u150": 0,
      "u300": 0,
      "o300": 0,
      "basis": "소액 구간의 3천만 원 미만 물건은 환금성·권리 문제 비중이 높아 하한을 둔다"
    },

    "min_fail_count": {
      "base": 1,
      "modifiers": [
        { "when": { "axis": { "RIGHTS": "R" } }, "delta": 1, "why": "특수물건은 유찰 누적이 정상" },
        { "when": { "axis": { "EXIT": "P" } }, "delta": 1, "why": "차익형은 낙찰가 자체가 싸야 성립" },
        { "when": { "regulated": true }, "delta": 1, "why": "규제지역은 경매 수요 쏠림으로 고가 낙찰 빈발 → 더 내려온 회차 대기" },
        { "when": { "axis": { "RIGHTS": "S", "WORK": "E" }, "budget": ["u300", "o300"] }, "delta": -1, "why": "우량·안전물건은 유찰이 적어 무리한 대기가 비현실적" }
      ],
      "floor": 0,
      "note": "1회 유찰 시 최저매각가격은 통상 20~30% 하락(법원별 상이)"
    },

    "rights_difficulty": {
      "S": { "value": "safe", "site": "특수조건 체크 안 함", "detail": "말소기준권리 이하 전부 소멸 · 인수 권리 0 · 인도명령 가능" },
      "R": { "value": "special_ok", "site": "특수조건 체크", "detail": "유치권 · 법정지상권 · 분묘기지권 · 지분매각 · 대지권미등기 · 선순위(대항력) 임차인" },
      "override": {
        "when": { "experience": "novice", "axis": { "RIGHTS": "R" } },
        "to": "safe",
        "flag": "novice_risk",
        "why": "초보 안전장치. 유형 코드는 바꾸지 않고 검색조건만 하향한다"
      }
    },

    "property_type": {
      "by_exit": {
        "K": ["오피스텔", "다세대/연립", "아파트(소형)"],
        "P": ["아파트", "다세대/연립"]
      },
      "by_budget": {
        "u50": { "remove": ["아파트", "아파트(소형)"], "why": "예산 대비 검색 결과가 거의 없음" },
        "u150": { "remove": [] },
        "u300": { "remove": [] },
        "o300": { "remove": ["다세대/연립"], "why": "큰 자본을 환금성 낮은 물건에 묶지 않는다" }
      }
    },

    "area": {
      "K": "전용 59㎡ 이하 (소형 임대형)",
      "P": "전용 59~84㎡ (국민평형, 환금성 우선)",
      "override_u50": "전용 59㎡ 이하"
    },

    "site_filterable": ["지역", "물건종류", "최저매각가격", "유찰횟수", "특수조건", "전용면적"],
    "notes_only": ["규제지역 여부", "대출 가용액·DSR", "취득세·양도세", "명도 난이도", "수리 상태"]
  },

  "golden_cases": [
    {
      "id": "G1",
      "input": { "type": "A-SHP", "budget": "u50", "region": "경기 평택시", "regulated": false, "ownership": "none", "experience": "novice" },
