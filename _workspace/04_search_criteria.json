        "area": "전용 59~84㎡",
        "flags": ["multi_acq_tax", "multi_flip_tax", "work_h_reserve", "rights_r_worst", "exit_p_short"]
      },
      "calc": "3억 × 2.31(비규제 다주택) × 0.85(H) × 0.9(R) = 5억 3,014만 / 유찰 1 + 1(R) + 1(P) = 3"
    },
    {
      "id": "G4",
      "input": { "type": "A-RHP", "budget": "u50", "region": "서울 강북구", "regulated": true, "ownership": "none", "experience": "novice" },
