    },
    {
      "id": "G3",
      "input": { "type": "A-RHP", "budget": "u300", "region": "경기 평택시", "regulated": false, "ownership": "multi", "experience": "expert" },
      "expect": {
        "price_max": 530145000,
        "price_min": 0,
        "min_fail_count": 3,
